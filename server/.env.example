# Postgres connection string (Railway provides this via the Postgres plugin)
DATABASE_URL=postgres://user:password@localhost:5432/nordic_rent

# Formspree form endpoint that receives inquiry emails
FORMSPREE_ENDPOINT=https://formspree.io/f/xreenzky

# Port the HTTP server listens on
PORT=3000

# Comma-separated list of origins allowed to call /api/inquiries from a browser
ALLOWED_ORIGINS=http://localhost:5173,https://nordicrent.no,https://www.nordicrent.no
